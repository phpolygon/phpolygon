parameters:
    level: 10
    paths:
        - src
    excludePaths:
        - src/Rendering/VulkanRenderer3D.php
        # class_alias shim for the pre-0.98 name of VioMainWindow, nothing to analyse
        - src/Runtime/VioWindow.php
    scanFiles:
        - stubs/vulkan.stub.php
        - stubs/vio.stub.php
        - stubs/glfw.stub.php
        - stubs/steamworks.stub.php
